# Client configuration (put only publishable values in config.js)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Supabase Edge Function secrets — NEVER commit real values
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
AI_CREDENTIALS_ENCRYPTION_KEY=GENERATE_A_LONG_RANDOM_SECRET

# Razorpay server-side secrets
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET
RAZORPAY_PRO_PLAN_ID=plan_xxxxxxxxx
RAZORPAY_MAX_PLAN_ID=plan_xxxxxxxxx
